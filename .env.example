# TrendPulse - Environment Variables Template
# Copy this file to .env and customize as needed.

DJANGO_SECRET_KEY=django-insecure-trendpulse-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# External Financial Data Configuration
# Yahoo Finance (yfinance) works without an API key.
# Optional provider keys if additional APIs are enabled:
FINNHUB_API_KEY=your_finnhub_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Sentiment Analysis Settings
# Available options: ProsusAI/finbert, distilbert-base-uncased-finetuned-sst-2-english, or rule-fallback
SENTIMENT_MODEL=ProsusAI/finbert
USE_GPU=False
